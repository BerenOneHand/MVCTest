@model MVCApp.Models.HomeViewModel
@{
    ViewData["Title"] = "Home Page";
}
<h2>Number of items per firstname/lastname</h2>
<table>
    <thead>
        <tr><th>Name</th><th>Count</th></tr>
    </thead>
    <tbody>
        @foreach (var summary in Model.Summaries)
        {
            <tr>
                <td>@Html.DisplayName(summary.Name)</td>
                <td>@Html.DisplayName(summary.Count.ToString())</td>
            </tr>
        }
    </tbody>
</table>
<br />
<h2>Addresses</h2>
<table>
    <thead>
        <tr><th></th></tr>
    </thead>
    <tbody>
        @foreach (var address in Model.Adresses)
        {
            <tr>
                <td>@Html.DisplayName(address)</td>
            </tr>
        }
    </tbody>
</table>